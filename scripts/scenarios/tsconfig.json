    "fake-host/cli.ts",
    "fake-host/state.ts",
    "fake-host/relay.ts",
    "fake-host/mailbox.ts",
    "fake-host/check.ts",
    "fake-host/sandbox.ts",
    "score.test.ts",
    "runtime.test.ts"
  ],
  "exclude": []
