#!/bin/bash

set -euo pipefail

# The operator's PATH is the executable trust boundary, minus empty and
# relative entries, which would resolve against whatever directory the
# operator happens to be in. The TypeScript control plane applies the same
# rule to every child process it starts.
NODE=''
SAFE_PATH=''
IFS=':' read -r -a SEARCH_DIRECTORIES <<< "${PATH:-}"
for directory in ${SEARCH_DIRECTORIES[@]+"${SEARCH_DIRECTORIES[@]}"}; do
  case "$directory" in
    /*) ;;
    *) continue ;;
  esac
  SAFE_PATH="${SAFE_PATH:+$SAFE_PATH:}$directory"
  if [ -z "$NODE" ] && [ -f "$directory/node" ] && [ -x "$directory/node" ]; then
    NODE="$directory/node"
  fi
done
[ -n "$NODE" ] || { printf '%s\n' 'Node.js was not found on PATH. Install Node.js 22 or later, then retry.' >&2; exit 1; }
export PATH="$SAFE_PATH"

SCRIPT="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT" ]; do
  SCRIPT_PARENT="${SCRIPT%/*}"
  [ -n "$SCRIPT_PARENT" ] || SCRIPT_PARENT='.'
  DIR="$(cd -P "$SCRIPT_PARENT" && pwd)"
  SCRIPT="$(/usr/bin/readlink "$SCRIPT")"
  [[ "$SCRIPT" != /* ]] && SCRIPT="$DIR/$SCRIPT"
done
SCRIPT_PARENT="${SCRIPT%/*}"
[ -n "$SCRIPT_PARENT" ] || SCRIPT_PARENT='.'
SCRIPT_DIR="$(cd -P "$SCRIPT_PARENT" && pwd)"
PROJECT_ROOT="${SCRIPT_DIR%/*}"

cd "$PROJECT_ROOT"
exec "$NODE" --import tsx setup/gws-ea.ts "$@"
