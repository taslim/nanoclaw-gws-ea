staged=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/**/*.ts')
if [ -z "$staged" ]; then
  exit 0
fi
git diff --cached --name-only -z --diff-filter=ACMR -- 'src/**/*.ts' | xargs -0 pnpm exec prettier --write
git diff --cached --name-only -z --diff-filter=ACMR -- 'src/**/*.ts' | xargs -0 git add
